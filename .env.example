[TEMPLATE]
# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# ── Risk engine calibration (optional, safe defaults if unset) ──────────
# Stacking bonus per additional distinct rule beyond the first hit (0–50)
RISK_STACK_BONUS_PER_RULE=6
# Upper bound on the total stacking bonus (0–100)
RISK_STACK_BONUS_MAX=24
# Hard cap for the final risk score (50–100)
RISK_SCORE_CAP=100
# Score → risk level thresholds
RISK_MEDIUM_THRESHOLD=30
RISK_HIGH_THRESHOLD=60
RISK_CRITICAL_THRESHOLD=85
# Per-rule severity overrides as JSON: {"RULE_ID": 0-100, ...}
# Rule ids: CMD_OBFUSCATION, ENCODED_SECRETS, EXFIL_HTTP, EXFIL_ENV,
# FILE_SWEEP, PROMPT_INJECTION, TOOL_HIJACK, SILENT_INSTALL,
# PERSISTENCE, PRIVILEGE_ESCALATION
# RISK_RULE_SEVERITY_OVERRIDES={"ENCODED_SECRETS":40,"EXFIL_HTTP":80}
